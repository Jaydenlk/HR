# ═══════════════════════════════════════════════════════════
# AI 大模型配置(多通道池:主力 → 备份,运行期自动降级)
# 主力顺序由 AI_PRIMARY_PROVIDER 决定:glm(默认)| deepseek | relay。
# 当前默认:GLM-5.1 coding 端点(OpenAI 兼容,主力) → DeepSeek 直连(Anthropic 兼容,备份);relay 中转停用。
# 生产角色(primary/backup/disabled)以 DB ai_providers 表为准(admin 面板 CRUD / 迁移 reconfigure)。
# 兼容:旧名 AI_PRIMARY_*/AI_FALLBACK_*/CLOUDDREAM_*/DEEPSEEK_* 仍被读取兜底,新部署请用下列新名。
# ═══════════════════════════════════════════════════════════
# 主力通道:glm(默认)| deepseek | relay
AI_PRIMARY_PROVIDER=glm

# ── GLM(智谱 GLM-5.1 coding 端点,OpenAI 兼容,默认主力) ──
# 密钥(必填才启用 GLM 通道;留空则该通道不构造,主力自动落到下一个有 key 的通道)
AI_GLM_API_KEY=your-glm-key
# coding 端点(OpenAI Chat Completions 兼容;AiService 自动拼 /chat/completions,勿手动加)
AI_GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# pro/flash 型号(coding 端点单型号 glm-5.1,推理模型;同型号最稳)
AI_GLM_MODEL_PRO=glm-5.1
AI_GLM_MODEL_FLASH=glm-5.1
# 超时/重试(推理模型耗时,超时给足)
AI_GLM_TIMEOUT_MS=120000
AI_GLM_MAX_RETRIES=3

# ── DeepSeek(直连官方 Anthropic 兼容端点,备份) ──
# 密钥(可选,留空则不启用该通道降级;旧名 AI_FALLBACK_API_KEY/DEEPSEEK_API_KEY 亦可兜底)
AI_DEEPSEEK_API_KEY=your-deepseek-key
# 分档型号:pro(诊断/改写核心)/ flash(解析类轻档)
AI_MODEL_PRO=deepseek-v4-pro
AI_MODEL_FLASH=deepseek-v4-flash
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
AI_DEEPSEEK_TIMEOUT_MS=120000
# 默认3:对瞬时连接错误自动退避重试,防单次网络抖动直接报503
AI_DEEPSEEK_MAX_RETRIES=3

# ── Relay(CloudDreamAI 中转 auto-v2,默认停用) ──
# 密钥(留空即停用;旧名 AI_PRIMARY_API_KEY/CLOUDDREAM_API_KEY 亦可兜底)
AI_RELAY_API_KEY=
AI_RELAY_MODEL=auto-v2
AI_RELAY_BASE_URL=https://api.tutorial.clouddreamai.com
AI_RELAY_TIMEOUT_MS=60000
# 默认0:中转快速失败立即降级,主通道挂时不空等
AI_RELAY_MAX_RETRIES=0

# AI 并发控制
# 同时进行的 AI 调用数上限(2C2G 推荐 2)
AI_MAX_CONCURRENCY=2
# 等待队列长度上限(超出直接返回 503)
AI_MAX_QUEUE=8

# ═══════════════════════════════════════════════════════════
# 语音转写 StepFun ASR(面试录音 → 带时间戳转写)
# 真实 key 写 .env.production,永不入库;留空时转写端点显式 503,不静默
# ═══════════════════════════════════════════════════════════
# StepFun Bearer key(必填才能转写;留空则 POST /interviews/:id/transcribe 返回错误)
STEP_API_KEY=
# StepFun API 基础地址
STEP_BASE_URL=https://api.stepfun.com/v1
# ASR 模型(实测跑通,不要改)
STEP_ASR_MODEL=stepaudio-2.5-asr
# 单次 ASR 超时(毫秒)
STEP_TIMEOUT_MS=120000
# 失败重试次数
STEP_MAX_RETRIES=1
# TTS 模型(语音模拟面试读题;实测读正常面试题清晰,不要改)
STEP_TTS_MODEL=step-tts-mini
# TTS 音色(cixingnansheng=磁性男声;其他官方音色见 StepFun 文档)
STEP_TTS_VOICE=cixingnansheng
# TTS 输出格式(mp3|wav|flac|opus|pcm;浏览器 <audio> 直接喂,缺省 mp3)
STEP_TTS_FORMAT=mp3
# 单次 TTS 超时(毫秒)
STEP_TTS_TIMEOUT_MS=60000
# 上传音频上限(MB);base64≈4/3 倍 + V0 并发 5,保守 25(约 25–50min mp3)
AUDIO_MAX_SIZE_MB=25

# ═══════════════════════════════════════════════════════════
# Auth 认证
# ═══════════════════════════════════════════════════════════
# JWT 签名密钥(必填,建议随机生成 32 位以上)
JWT_SECRET=
# 注册邀请码,多个用逗号分隔(内置默认码: COACH2026)
INVITE_CODES=
# 管理员邮箱白名单,多个用逗号分隔;登录时邮箱命中即提升为 admin(含测试通道 dev-login)
ADMIN_EMAILS=admin@coach.dev

# 测试通道开关:置 1 开放 POST /api/auth/dev-login(免验证码免邀请码,联调用)
# ⚠️ 试运行/生产严禁开启;端点另有 NODE_ENV!=='production' 二重保护,production 即使置 1 也返回 404
DEV_LOGIN=0

# ═══════════════════════════════════════════════════════════
# 邮件 SMTP(发送登录验证码)
# 开发态可全部留空:验证码仅打日志,且 request-code 接口回吐 dev_code 便于自测
# production 必须配置 SMTP_HOST(由 main.ts 启动校验,缺失即拒绝启动)
# ═══════════════════════════════════════════════════════════
# SMTP 服务器地址(如 smtp.exmail.qq.com)
SMTP_HOST=
# SMTP 端口(465 走 SSL,587 走 STARTTLS)
SMTP_PORT=465
# SMTP 登录用户名
SMTP_USER=
# SMTP 登录密码 / 授权码
SMTP_PASS=
# 发件人地址
SMTP_FROM=no-reply@coach.dev

# ═══════════════════════════════════════════════════════════
# 配额与安全
# ═══════════════════════════════════════════════════════════
# 每个用户每日 AI 调用次数上限(整数,默认 20;可被 users.daily_quota_override 覆盖)
DAILY_AI_QUOTA=20
# CORS 来源白名单,多个用逗号分隔(如 https://coach.example.com,https://www.coach.example.com)
# 未配置且非 production 时回退为允许所有来源(仅开发态);production 未配置则拒绝启动
CORS_ORIGINS=

# ═══════════════════════════════════════════════════════════
# 数据库
# ═══════════════════════════════════════════════════════════
# 数据库类型:sqlite(默认) 或 postgres
DB_TYPE=sqlite
# SQLite 数据库文件路径(仅 sqlite 时生效)
DB_PATH=./coach-dev.db
# PostgreSQL 连接参数(仅 DB_TYPE=postgres 时生效)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
# 连接初始化时是否自动跑迁移(仅 postgres):1=自动跑,留空/0=不自动(由 CLI 显式 migration:run)
# 生产推荐留空,在部署流程里显式执行 migration,避免启动时隐式改表
DB_MIGRATIONS_RUN=
# 备份脚本(scripts/backup.sh)输出目录,留空默认 packages/api/backups
BACKUP_DIR=

# ═══════════════════════════════════════════════════════════
# HTTP 服务器
# ═══════════════════════════════════════════════════════════
# 监听端口
PORT=3002
# 整体请求超时(毫秒)
HTTP_REQUEST_TIMEOUT_MS=300000
# 响应头超时(毫秒)
HTTP_HEADERS_TIMEOUT_MS=65000
# Keep-Alive 超时(毫秒)
HTTP_KEEPALIVE_TIMEOUT_MS=61000
# 运行环境(development | production)
NODE_ENV=development
# 应用版本号,透出到 GET /api/health 的 version 字段(留空回退 unknown;建议填镜像 tag / git short sha)
APP_VERSION=

# ═══════════════════════════════════════════════════════════
# OSS 文件存储
# ═══════════════════════════════════════════════════════════
# 对象存储访问密钥
OSS_ACCESS_KEY=
OSS_ACCESS_SECRET=
# 存储桶名称
OSS_BUCKET=
# 存储区域
OSS_REGION=

# ═══════════════════════════════════════════════════════════
# Feed / 外部内容源
# ═══════════════════════════════════════════════════════════
# 外部 Feed 单次拉取超时(毫秒)
FEED_SOURCE_TIMEOUT_MS=
# 每日查询预算上限
DAILY_QUERY_BUDGET=
# 小红书 MCP 代理地址
XHS_MCP_BASE_URL=
# 小红书导入超时(毫秒)
XHS_IMPORT_TIMEOUT_MS=
# 小红书导入失败重试次数
XHS_IMPORT_RETRIES=
# 微信公众号 RSS 源列表(逗号分隔)
WECHAT_SOURCE_FEEDS=
# 微信 RSS 服务用户名
WECHAT_RSS_USERNAME=
# 微信 RSS 服务密码
WECHAT_RSS_PASSWORD=
# 通用 RSS Feed 地址
RSS_FEED_URL=
