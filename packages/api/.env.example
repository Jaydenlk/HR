# ═══════════════════════════════════════════════════════════
# AI 大模型配置
# 主通道:CloudDreamAI 中转(auto-v2)
# ═══════════════════════════════════════════════════════════
# 主通道密钥(必填)
CLOUDDREAM_API_KEY=
# 主通道模型名称
CLOUDDREAM_MODEL=auto-v2
# 主通道 API 基础地址
CLOUDDREAM_BASE_URL=https://api.tutorial.clouddreamai.com
# 主通道超时(毫秒)
AI_PRIMARY_TIMEOUT_MS=60000
# 主通道重试次数(默认0:快速失败立即降级,主通道挂时不空等)
AI_PRIMARY_MAX_RETRIES=0

# 备用通道:DeepSeek(配置后才启用降级)
# 备用通道密钥(可选,留空则不启用降级)
DEEPSEEK_API_KEY=
# 备用通道模型名称
DEEPSEEK_MODEL=deepseek-chat
# 备用通道 API 基础地址(Anthropic 兼容端点)
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# 备用通道超时(毫秒)
AI_FALLBACK_TIMEOUT_MS=120000
# 备用通道重试次数(默认3:对瞬时连接错误自动退避重试,防单次网络抖动直接报503)
AI_FALLBACK_MAX_RETRIES=3

# AI 并发控制
# 同时进行的 AI 调用数上限(2C2G 推荐 2)
AI_MAX_CONCURRENCY=2
# 等待队列长度上限(超出直接返回 503)
AI_MAX_QUEUE=8

# ═══════════════════════════════════════════════════════════
# Auth 认证
# ═══════════════════════════════════════════════════════════
# JWT 签名密钥(必填,建议随机生成 32 位以上)
JWT_SECRET=
# 注册邀请码,多个用逗号分隔(内置默认码: COACH2026)
INVITE_CODES=
# 管理员邮箱白名单,多个用逗号分隔;登录时邮箱命中即提升为 admin(含测试通道 dev-login)
ADMIN_EMAILS=admin@coach.dev

# 测试通道开关:置 1 开放 POST /api/auth/dev-login(免验证码免邀请码,联调用)
# ⚠️ 试运行/生产严禁开启;端点另有 NODE_ENV!=='production' 二重保护,production 即使置 1 也返回 404
DEV_LOGIN=0

# ═══════════════════════════════════════════════════════════
# 邮件 SMTP(发送登录验证码)
# 开发态可全部留空:验证码仅打日志,且 request-code 接口回吐 dev_code 便于自测
# production 必须配置 SMTP_HOST(由 main.ts 启动校验,缺失即拒绝启动)
# ═══════════════════════════════════════════════════════════
# SMTP 服务器地址(如 smtp.exmail.qq.com)
SMTP_HOST=
# SMTP 端口(465 走 SSL,587 走 STARTTLS)
SMTP_PORT=465
# SMTP 登录用户名
SMTP_USER=
# SMTP 登录密码 / 授权码
SMTP_PASS=
# 发件人地址
SMTP_FROM=no-reply@coach.dev

# ═══════════════════════════════════════════════════════════
# 配额与安全
# ═══════════════════════════════════════════════════════════
# 每个用户每日 AI 调用次数上限(整数,默认 20;可被 users.daily_quota_override 覆盖)
DAILY_AI_QUOTA=20
# CORS 来源白名单,多个用逗号分隔(如 https://coach.example.com,https://www.coach.example.com)
# 未配置且非 production 时回退为允许所有来源(仅开发态);production 未配置则拒绝启动
CORS_ORIGINS=

# ═══════════════════════════════════════════════════════════
# 数据库
# ═══════════════════════════════════════════════════════════
# 数据库类型:sqlite(默认) 或 postgres
DB_TYPE=sqlite
# SQLite 数据库文件路径(仅 sqlite 时生效)
DB_PATH=./coach-dev.db
# PostgreSQL 连接参数(仅 DB_TYPE=postgres 时生效)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=

# ═══════════════════════════════════════════════════════════
# HTTP 服务器
# ═══════════════════════════════════════════════════════════
# 监听端口
PORT=3002
# 整体请求超时(毫秒)
HTTP_REQUEST_TIMEOUT_MS=300000
# 响应头超时(毫秒)
HTTP_HEADERS_TIMEOUT_MS=65000
# Keep-Alive 超时(毫秒)
HTTP_KEEPALIVE_TIMEOUT_MS=61000
# 运行环境(development | production)
NODE_ENV=development

# ═══════════════════════════════════════════════════════════
# OSS 文件存储
# ═══════════════════════════════════════════════════════════
# 对象存储访问密钥
OSS_ACCESS_KEY=
OSS_ACCESS_SECRET=
# 存储桶名称
OSS_BUCKET=
# 存储区域
OSS_REGION=

# ═══════════════════════════════════════════════════════════
# Feed / 外部内容源
# ═══════════════════════════════════════════════════════════
# 外部 Feed 单次拉取超时(毫秒)
FEED_SOURCE_TIMEOUT_MS=
# 每日查询预算上限
DAILY_QUERY_BUDGET=
# 小红书 MCP 代理地址
XHS_MCP_BASE_URL=
# 小红书导入超时(毫秒)
XHS_IMPORT_TIMEOUT_MS=
# 小红书导入失败重试次数
XHS_IMPORT_RETRIES=
# 微信公众号 RSS 源列表(逗号分隔)
WECHAT_SOURCE_FEEDS=
# 微信 RSS 服务用户名
WECHAT_RSS_USERNAME=
# 微信 RSS 服务密码
WECHAT_RSS_PASSWORD=
# 通用 RSS Feed 地址
RSS_FEED_URL=
