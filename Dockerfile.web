# syntax=docker/dockerfile:1
# ──────────────────────────────────────────────────────────────────────────────
# Coach Web(Next.js 16.2.6)生产镜像 — 多阶段构建 + standalone 输出
# 构建上下文必须是 monorepo 仓库根(docker build -f Dockerfile.web .)。
#
# 前置依赖(集成轨接线):packages/web/next.config.ts 必须设
#   output: 'standalone'
#   outputFileTracingRoot: path.join(__dirname, '../../')   // monorepo 根,否则 trace 漏 workspace 依赖
# 否则 .next/standalone 不会生成,本 Dockerfile 的 runner 阶段会找不到 server.js。
# 依据:Next 官方 output.md —— monorepo 下需 outputFileTracingRoot 指向仓库根。
# ──────────────────────────────────────────────────────────────────────────────

# ── 1. base ───────────────────────────────────────────────────────────────────
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo

# ── 2. deps:全量安装(含 devDeps,next build 需要) ────────────────────────────
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/api/package.json packages/api/package.json
COPY packages/web/package.json packages/web/package.json
RUN pnpm install --frozen-lockfile

# ── 3. build:next build → .next/standalone ────────────────────────────────────
FROM deps AS build
ENV NEXT_TELEMETRY_DISABLED=1
COPY tsconfig.base.json ./
COPY packages/web packages/web
# NEXT_PUBLIC_* 是构建期内联进客户端 bundle 的;部署不同环境需在 build 时传入。
ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_DEV_LOGIN=0
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_DEV_LOGIN=$NEXT_PUBLIC_DEV_LOGIN
RUN pnpm --filter @coach/web build

# ── 4. runner:仅 standalone 产物 ──────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# standalone server 默认监听 3000;compose/反代按此对接,容器内统一 3000。
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
# standalone 输出已自带精简 node_modules + server.js,无需再 pnpm install。
# outputFileTracingRoot 指向仓库根 → standalone 内部以 /repo 为根复刻目录结构。
COPY --from=build --chown=node:node /repo/packages/web/.next/standalone /app
# 静态资源与 public 不在 standalone 默认拷贝范围内,需手动补齐(见 Next output.md)。
COPY --from=build --chown=node:node /repo/packages/web/.next/static /app/packages/web/.next/static
COPY --from=build --chown=node:node /repo/packages/web/public /app/packages/web/public
USER node
EXPOSE 3000
# standalone 的 server.js 位于以仓库根为基的相对路径下(因 outputFileTracingRoot=仓库根)。
CMD ["node", "packages/web/server.js"]
