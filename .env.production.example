# ══════════════════════════════════════════════════════════════════════════════
# Coach 生产环境变量模板
# 复制为 .env.production 后逐项填写,再 docker compose -f docker-compose.prod.yml up -d。
# ⚠️ .env.production 含密钥,严禁提交到 git。.gitignore 已显式追加 .env.production 规则忽略它;
#    部署前务必复核:`git check-ignore .env.production` 应有输出(无输出=未忽略,切勿提交)。
# ══════════════════════════════════════════════════════════════════════════════

# ── 运行环境 ──────────────────────────────────────────────────────────────────
# 固定 production:开启 CORS/SMTP 强校验、关闭 synchronize(走 migration)。
NODE_ENV=production
# API 容器内监听端口(compose 已固定 3002,改这里需同步改 compose)。
PORT=3002
# 应用版本号,透出到 GET /api/health 的 version 字段(建议填镜像 tag / git short sha)。
APP_VERSION=

# ── 反向代理域名(Caddy) ──────────────────────────────────────────────────────
# 配置真实域名(如 coach.example.com)→ Caddy 自动签发 HTTPS 证书。
# 留空 → Caddy 回退 :80 纯 HTTP(仅供内网 / IP 直连调试,公网严禁留空)。
DOMAIN=

# ── 数据库(PostgreSQL 16) ────────────────────────────────────────────────────
# DB_TYPE 在 compose 中已硬编码 postgres,这里仅作显式声明。
DB_TYPE=postgres
# DB_HOST/DB_PORT 在 compose 内指向 postgres 服务,无需改;留作文档。
DB_HOST=postgres
DB_PORT=5432
# 下列三项同时被 postgres 容器(建库)与 api 容器(连库)读取,务必填写且一致。
DB_USER=coach
DB_PASS=请改成强密码
DB_NAME=coach
# 启动时是否自动跑迁移:默认不开(留空/0)——迁移由部署流程显式 migration:run 触发,
# 避免连接初始化时隐式改表的误迁移风险(见 deploy/README.md §1.3 / §2)。仅受控环境可置 1。
DB_MIGRATIONS_RUN=
# 数据库备份输出目录(packages/api/scripts/backup.sh 用):留空走默认 packages/api/backups/。
# 备份在「容器外」的宿主上落盘(脚本经 docker compose exec 进 postgres 容器跑 pg_dump 再流回宿主),
# 故此处填宿主路径,不是容器内路径;建议指向有异地同步的持久化目录。
BACKUP_DIR=

# ── 鉴权 ──────────────────────────────────────────────────────────────────────
# JWT 签名密钥(必填):用长随机串,可执行 openssl rand -hex 32 生成。
JWT_SECRET=请改成至少32位随机串

# ── AI 通道密钥加密主密钥(production 必填,缺失/非法则拒绝启动) ───────────────
# AES-256-GCM 主密钥:64 位 hex(=32 字节)。生成:openssl rand -hex 32。
# 用途:admin 面板录入的 AI 通道密钥以此密钥加密后存库(ai_providers.api_key_enc);
#       无此密钥则库内加密密钥无法解密,AI 全线不可用 → 启动期 fail-fast 拒启。
# ⚠️ 一旦设定并已加密落库,切勿更换:更换后旧密文无法解密(需在面板重录所有通道密钥)。
PROVIDER_ENC_KEY=请填64位hex随机串_openssl_rand_hex_32

# ── AI 主通道(必填其一:新名 AI_PRIMARY_API_KEY 或旧名 CLOUDDREAM_API_KEY) ────
# 主通道 = CloudDreamAI 中转(路由到 GLM-5)。
AI_PRIMARY_API_KEY=
# 模型别名,默认 auto-v2(CloudDreamAI 唯一能接到 GLM-5 的路由别名,通常不改)。
AI_PRIMARY_MODEL=auto-v2
AI_PRIMARY_BASE_URL=https://api.tutorial.clouddreamai.com
# 主通道超时/重试(可选,留空走默认 60000 / 0)。
AI_PRIMARY_TIMEOUT_MS=
AI_PRIMARY_MAX_RETRIES=

# ── AI 备用通道(可选但强烈建议:DeepSeek,主通道挂时自动降级) ────────────────
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=deepseek-chat
AI_FALLBACK_BASE_URL=https://api.deepseek.com/anthropic
AI_FALLBACK_TIMEOUT_MS=
AI_FALLBACK_MAX_RETRIES=

# ── AI 并发限流(可选,留空走默认 max=2 / queue=8;4C4G 单机不建议调高) ────────
AI_MAX_CONCURRENCY=
AI_MAX_QUEUE=

# ── 邮件(production 必填 RESEND_API_KEY 或 SMTP_HOST 其中之一,否则启动即报错) ─
# 推荐 Resend HTTPS(443 端口,不受云厂商封 SMTP 端口影响)。
RESEND_API_KEY=
# SMTP 备选通道(配了 RESEND_API_KEY 时不会用到)。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 发件人显示地址,如 "Coach <no-reply@example.com>"。Resend 通道也用它,域名须在 Resend 完成验证。
SMTP_FROM=

# ── CORS(production 必填,否则启动即报错) ────────────────────────────────────
# 允许的前端来源,逗号分隔。同源部署(Caddy 反代)填站点域名即可。
CORS_ORIGINS=https://coach.example.com

# ── 试运行运营(可选) ─────────────────────────────────────────────────────────
# 管理员邮箱白名单(逗号分隔):命中邮箱登录后 role 提升为 admin。
ADMIN_EMAILS=
# 初始邀请码(首次部署必配,跑 seed 时创建;production 不会自动生成任何邀请码,
# 没有它第一个用户连管理员都注册不进来)。上线后可在管理后台增发/停用。
INITIAL_INVITE_CODE=
# 初始邀请码使用上限(默认 50)。
INITIAL_INVITE_MAX_USES=
# 每日单用户 AI 调用配额(整数,默认 20)。
DAILY_AI_QUOTA=20
# 测试通道开关:production 严禁置 1,保持 0(或不填)。
DEV_LOGIN=0

# ── HTTP 超时(可选,留空走默认;AI 单请求可达 ~190s,勿调太小) ────────────────
HTTP_REQUEST_TIMEOUT_MS=
HTTP_HEADERS_TIMEOUT_MS=
HTTP_KEEPALIVE_TIMEOUT_MS=
