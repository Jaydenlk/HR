{
  "name": "jd-too-short",
  "description": "JD input shorter than 30 characters triggers degraded chain with explicit low-confidence warning.",
  "input": {
    "user_message": "帮我分析这个 JD 并匹配我的简历。",
    "context": {
      "resume_text": "虚构用户C，产品经理，4年经验，主导过两个 B 端 SaaS 产品从 0 到 1。",
      "jd_text": "产品经理，有经验",
      "additional_context": {}
    }
  },
  "expected_skills_invoked": [
    "jd-analyzer",
    "career-principal"
  ],
  "expected_output_properties": {
    "confidence_level": "low",
    "has_source_citations": false,
    "refuses_fabrication": false,
    "degraded_mode": true
  },
  "assertions": [
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "contains",
      "value": "jd-analyzer",
      "description": "必须调用jd-analyzer"
    },
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "not_contains",
      "value": "resume-tailor",
      "description": "不得调用resume-tailor"
    },
    {
      "type": "contains",
      "path": "jd_analyzer.warnings",
      "operator": "contains",
      "value": "JD 内容不足",
      "description": "JD分析警告必须包含内容不足提示"
    },
    {
      "type": "confidence_check",
      "path": "output.confidence",
      "operator": "lte",
      "value": 0.40,
      "description": "置信度应低于0.40"
    },
    {
      "type": "contains",
      "path": "output.user_guidance",
      "operator": "contains",
      "value": "请提供更完整的职位描述",
      "description": "用户指引必须建议提供更完整的职位描述"
    }
  ]
}
