{
  "name": "role-transition-advisor-skill-gap-planner-learning-roadmap-builder-chain",
  "description": "Tests the full career transition analysis chain: feasibility assessment, gap quantification, and actionable learning roadmap generation.",
  "input": {
    "user_message": "我目前是传统制造业的供应链管理岗（3年），想转到互联网大厂做产品经理，可行吗？需要补哪些技能？怎么学？",
    "context": {
      "profile_summary": {
        "current_role": "供应链管理专员",
        "industry": "传统制造业",
        "years_of_experience": 3,
        "education": "985高校工业工程本科",
        "skills": ["供应链优化", "ERP系统操作", "数据分析（Excel）", "跨部门协作"],
        "achievements": "主导了一个降低库存积压20%的项目",
        "available_time_per_week": "10小时"
      },
      "target_role": {
        "type": "产品经理",
        "industry": "互联网大厂",
        "level": "初级（0-2年产品经验要求）"
      }
    }
  },
  "expected_skills_invoked": ["role-transition-advisor", "skill-gap-planner", "learning-roadmap-builder"],
  "expected_output_properties": {
    "has_feasibility_assessment": true,
    "has_transferable_skills_identified": true,
    "has_gap_list_with_priority": true,
    "has_learning_roadmap_with_timeline": true,
    "roadmap_respects_time_constraint": true
  },
  "assertions": [
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "contains",
      "value": "role-transition-advisor",
      "description": "职业转型顾问必须被调用"
    },
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "contains",
      "value": "skill-gap-planner",
      "description": "技能差距规划器必须被调用"
    },
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "contains",
      "value": "learning-roadmap-builder",
      "description": "学习路线图构建器必须被调用"
    },
    {
      "type": "contains",
      "path": "output.text",
      "operator": "contains",
      "value": "供应链",
      "description": "职业转型顾问必须识别供应链经验对运营/增长产品岗位的可迁移性"
    },
    {
      "type": "field_check",
      "path": "output.skill_gaps[*].priority",
      "operator": "exists",
      "value": true,
      "description": "技能差距规划器必须产出带优先级排序和获取难度评估的缺失技能列表"
    },
    {
      "type": "field_check",
      "path": "output.roadmap.weekly_hours_required",
      "operator": "lte",
      "value": 10,
      "description": "学习路线图每周所需时间不能超过候选人声明的10小时约束"
    },
    {
      "type": "field_check",
      "path": "output.roadmap.phases[*].resources",
      "operator": "exists",
      "value": true,
      "description": "路线图必须包含具体资源类型（课程、项目、社群），而非模糊分类"
    },
    {
      "type": "field_check",
      "path": "output.transition_timeline_months",
      "operator": "exists",
      "value": true,
      "description": "必须说明现实转型时间线（可能6-18个月），不夸大鼓励"
    },
    {
      "type": "field_check",
      "path": "output.skill_gaps[*].requires_real_experience",
      "operator": "exists",
      "value": true,
      "description": "必须区分可学习的技能与需要真实项目经验才能获得的技能"
    }
  ],
  "must_not_contain": [
    {
      "pattern": "保证成功转型|guaranteed.*transition|一定能转型成功",
      "reason": "不能对按路线图执行后的转型结果做保证"
    },
    {
      "pattern": "产品经理薪资.*[0-9]+[kK万]",
      "reason": "不能在无来源支撑情况下给出目标岗位薪资数字"
    },
    {
      "pattern": "每周.*超过10小时|每天.*超过",
      "reason": "路线图不能超过候选人声明的时间约束而不予标注"
    },
    {
      "pattern": "不可能转型|impossible.*transition|完全没有可能",
      "reason": "不能在无证据情况下断言转型不可能"
    }
  ]
}
