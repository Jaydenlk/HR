{
  "name": "referral-strategy-networking-message-writer-chain",
  "description": "Tests that referral-strategy identifies the optimal referral path and contact approach, and networking-message-writer produces a personalized, non-generic cold outreach message.",
  "input": {
    "user_message": "我想内推进字节跳动数据平台部门的数据工程师岗位。我在领英上找到了两个人：一个是字节的数据工程师（和我同校，但不认识），一个是数据平台部门的组长（我们有共同前同事）。帮我制定策略并写消息。",
    "context": {
      "candidate_profile": {
        "background": "3年数据工程经验，Spark/Flink方向，现在一家B2B SaaS公司",
        "school": "浙江大学",
        "mutual_connections": {
          "contact_b": "前同事王某在该组长团队工作过"
        }
      },
      "target_company": "字节跳动",
      "target_department": "数据平台部门",
      "target_role": "数据工程师",
      "contacts": [
        {
          "id": "contact_a",
          "role": "数据工程师",
          "company": "字节跳动",
          "connection": "同校校友，无直接联系",
          "channel": "领英"
        },
        {
          "id": "contact_b",
          "role": "数据平台组长",
          "company": "字节跳动",
          "connection": "共同前同事（王某）",
          "channel": "领英"
        }
      ]
    }
  },
  "expected_skills_invoked": ["referral-strategy", "networking-message-writer"],
  "expected_output_properties": {
    "has_contact_priority_recommendation": true,
    "has_approach_rationale_per_contact": true,
    "has_message_for_each_contact": true,
    "messages_are_personalized": true,
    "messages_are_concise": true
  },
  "assertions": [
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "contains",
      "value": "referral-strategy",
      "description": "内推策略必须被调用"
    },
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "contains",
      "value": "networking-message-writer",
      "description": "人脉消息撰写器必须被调用"
    },
    {
      "type": "field_check",
      "path": "output.strategy.priority_contact",
      "operator": "eq",
      "value": "contact_b",
      "description": "内推策略必须推荐contact_b（有共同前同事的组长）为优先联系对象"
    },
    {
      "type": "contains",
      "path": "output.strategy.contact_b_approach",
      "operator": "contains",
      "value": "王",
      "description": "策略必须包含在给contact_b的消息中提及共同前同事王某的战术"
    },
    {
      "type": "field_check",
      "path": "output.messages",
      "operator": "exists",
      "value": true,
      "description": "人脉消息撰写器必须为每位联系人产出各自不同的个性化消息"
    },
    {
      "type": "contains",
      "path": "output.messages.contact_a",
      "operator": "contains",
      "value": "浙江大学",
      "description": "给contact_a的消息必须利用校友关系，但不过度假设亲密程度"
    },
    {
      "type": "contains",
      "path": "output.messages.contact_b",
      "operator": "contains",
      "value": "王",
      "description": "给contact_b的消息必须以共同前同事为开篇钩子"
    },
    {
      "type": "length_lte",
      "path": "output.messages.contact_a.opening_line",
      "operator": "lte",
      "value": 200,
      "description": "消息开篇行不超过200字（符合微信/领英范式）"
    },
    {
      "type": "not_contains",
      "path": "output.messages.contact_a",
      "operator": "not_contains",
      "value": "能否帮我内推",
      "description": "消息不能在第一句就提出内推请求"
    },
    {
      "type": "not_contains",
      "path": "output.messages.contact_b",
      "operator": "not_contains",
      "value": "能否帮我内推",
      "description": "消息不能在第一句就提出内推请求"
    }
  ],
  "must_not_contain": [
    {
      "pattern": "统一模板|同一条消息.*两位|both contacts.*same message",
      "reason": "不能对两位联系人发同一条消息"
    },
    {
      "pattern": "第一句.*请帮我内推|第一句.*能否内推|opening.*ask.*referral",
      "reason": "冷联消息不能在第一句就直接要求内推"
    },
    {
      "pattern": "我们曾经.*合作|我们见过面|我认识你",
      "reason": "不能捏造候选人与联系人的关系细节"
    }
  ]
}
