{
  "name": "market-radar-degradation-with-no-live-adapters",
  "description": "Tests that market-radar correctly degrades to an insufficient confidence state when no live data adapters are available, rather than fabricating market data.",
  "input": {
    "user_message": "现在互联网大厂后端工程师的招聘热度怎么样？哪些公司还在扩招？",
    "context": {
      "live_adapters_available": [],
      "knowledge_graph_last_updated": "2024-Q1"
    }
  },
  "expected_skills_invoked": ["market-radar", "source-quality-auditor"],
  "expected_output_properties": {
    "confidence_level": "low_or_insufficient",
    "has_explicit_data_limitation_notice": true,
    "has_fallback_guidance": true,
    "refuses_to_state_current_headcount": true
  },
  "assertions": [
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "contains",
      "value": "market-radar",
      "description": "市场雷达必须被调用"
    },
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "contains",
      "value": "source-quality-auditor",
      "description": "数据源质量审查器必须被调用以标记知识图谱陈旧"
    },
    {
      "type": "contains",
      "path": "output.text",
      "operator": "contains",
      "value": "无实时数据",
      "description": "market-radar必须明确说明没有可用的实时数据来源"
    },
    {
      "type": "field_check",
      "path": "output.confidence",
      "operator": "in",
      "value": ["low", "insufficient"],
      "description": "置信度必须标注为低或不足，不能为中或高"
    },
    {
      "type": "not_contains",
      "path": "output.text",
      "operator": "not_contains",
      "value": "正在扩招",
      "description": "不能在无日期来源的情况下声称某公司正在扩招"
    },
    {
      "type": "field_check",
      "path": "output.fallback_sources",
      "operator": "exists",
      "value": true,
      "description": "必须提供替代方案指引：用户可以从哪里查到当前数据（如牛客、脉脉、Boss直聘）"
    },
    {
      "type": "contains",
      "path": "output.text",
      "operator": "contains",
      "value": "2024",
      "description": "知识图谱中的历史趋势数据必须明确标注为历史数据，不能作为当前数据呈现"
    }
  ],
  "must_not_contain": [
    {
      "pattern": "[0-9]+人.*招聘|HC.*[0-9]+|headcount.*[0-9]+",
      "reason": "不能给出以当前数据呈现的具体公司招聘人数"
    },
    {
      "pattern": "目前.*正在大量招聘|现在.*扩招中",
      "reason": "不能在无日期来源情况下声称特定公司当前正在扩招"
    },
    {
      "pattern": "confidence.*medium|confidence.*high|置信度.*中|置信度.*高",
      "reason": "无实时数据时置信度不能为中或高"
    },
    {
      "pattern": "招聘热度.*高涨|市场火热",
      "reason": "不能在无数据情况下杜撰招聘活跃度数据"
    }
  ]
}
