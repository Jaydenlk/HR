{
  "name": "daily-plan-generator-with-upcoming-interviews",
  "description": "Tests that daily-plan-generator integrates application tracker state and upcoming interview schedule to produce a realistic, prioritized daily action plan.",
  "input": {
    "user_message": "帮我规划今天和明天的求职任务。",
    "context": {
      "current_date": "2025-03-10",
      "application_tracker_state": [
        { "company": "美团", "role": "产品经理", "status": "等待HR面结果", "last_action_date": "2025-03-07" },
        { "company": "京东", "role": "产品经理", "status": "技术面已过，等终面通知", "last_action_date": "2025-03-08" },
        { "company": "滴滴", "role": "产品经理", "status": "简历投递", "last_action_date": "2025-03-05" }
      ],
      "upcoming_interviews": [
        { "company": "京东", "round": "终面（VP轮）", "datetime": "2025-03-12 14:00", "format": "线下" },
        { "company": "腾讯", "round": "一面", "datetime": "2025-03-11 10:00", "format": "视频" }
      ],
      "candidate_available_hours_today": 6,
      "candidate_available_hours_tomorrow": 8
    }
  },
  "expected_skills_invoked": ["daily-plan-generator", "application-tracker"],
  "expected_output_properties": {
    "has_today_plan": true,
    "has_tomorrow_plan": true,
    "plans_prioritize_imminent_interviews": true,
    "plans_fit_within_available_hours": true,
    "has_follow_up_actions_for_pending_applications": true
  },
  "assertions": [
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "contains",
      "value": "daily-plan-generator",
      "description": "每日计划生成器必须被调用"
    },
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "contains",
      "value": "application-tracker",
      "description": "投递追踪器必须被调用以获取当前状态"
    },
    {
      "type": "contains",
      "path": "output.today_plan.text",
      "operator": "contains",
      "value": "腾讯",
      "description": "今日计划必须优先安排腾讯面试准备（明日10:00面试）"
    },
    {
      "type": "contains",
      "path": "output.tomorrow_plan.text",
      "operator": "contains",
      "value": "京东",
      "description": "明日计划必须为京东终面（3月12日14:00）分配大量时间"
    },
    {
      "type": "contains",
      "path": "output.text",
      "operator": "contains",
      "value": "美团",
      "description": "必须包含对美团的跟进行动（已等待自3月7日）"
    },
    {
      "type": "field_check",
      "path": "output.today_plan.total_hours",
      "operator": "lte",
      "value": 6,
      "description": "今日计划总时间不超过6小时"
    },
    {
      "type": "field_check",
      "path": "output.tomorrow_plan.total_hours",
      "operator": "lte",
      "value": 8,
      "description": "明日计划总时间不超过8小时"
    },
    {
      "type": "not_contains",
      "path": "output.today_plan.text",
      "operator": "not_contains",
      "value": "通用准备",
      "description": "任务必须具体可执行，不能是通用建议（如应具体到'研究腾讯PM岗位JD'而非'准备'）"
    },
    {
      "type": "contains",
      "path": "output.text",
      "operator": "contains",
      "value": "滴滴",
      "description": "必须说明滴滴投递已5天以上无回应，建议跟进或降低优先级"
    }
  ],
  "must_not_contain": [
    {
      "pattern": "面试当天.*安排任务|interview.*same.*time|10:00.*任务安排",
      "reason": "任务不能与面试时间冲突"
    },
    {
      "pattern": "今日.*超过6小时|明日.*超过8小时",
      "reason": "计划总时间不能超过可用时间"
    },
    {
      "pattern": "通用建议|一般性准备|generic.*advice",
      "reason": "所有建议必须与追踪器中的具体公司和阶段挂钩"
    }
  ]
}
