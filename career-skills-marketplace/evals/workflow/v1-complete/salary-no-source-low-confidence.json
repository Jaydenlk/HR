{
  "name": "salary-radar with no live data produces low-confidence output",
  "description": "Tests that salary-radar correctly reports low confidence and refuses to state precise salary ranges when no live data sources are available and the role is outside the knowledge graph.",
  "input": {
    "user_message": "我想知道湖南长沙的中小型民营企业里，工业互联网方向的产品经理，3年经验，薪资大概是多少？",
    "context": {
      "live_adapters_available": [],
      "knowledge_graph_coverage": {
        "cities": ["北京", "上海", "深圳", "杭州", "广州"],
        "company_types": ["互联网大厂", "知名外资", "头部创业公司"],
        "note": "长沙中小民营企业不在知识图谱覆盖范围内"
      }
    }
  },
  "expected_skills_invoked": ["salary-radar", "source-quality-auditor"],
  "expected_output_properties": {
    "confidence_level": "low_or_insufficient",
    "refuses_precise_range": true,
    "has_explicit_coverage_gap_notice": true,
    "has_suggested_data_sources": true
  },
  "assertions": [
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "contains",
      "value": "salary-radar",
      "description": "薪资雷达必须被调用"
    },
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "contains",
      "value": "source-quality-auditor",
      "description": "数据源质量审查器必须被调用以标记无数据情况"
    },
    {
      "type": "contains",
      "path": "output.text",
      "operator": "contains",
      "value": "长沙",
      "description": "输出必须明确说明长沙中小型民营企业工业互联网岗位不在知识图谱覆盖范围内"
    },
    {
      "type": "field_check",
      "path": "output.confidence",
      "operator": "in",
      "value": ["low", "insufficient"],
      "description": "置信度必须标注为低或不足，不能是中或高"
    },
    {
      "type": "not_contains",
      "path": "output.text",
      "operator": "not_contains",
      "value": "18k-25k",
      "description": "不能给出具体薪资区间（如18k-25k）作为可靠数据"
    },
    {
      "type": "contains",
      "path": "output.text",
      "operator": "contains",
      "value": "本地",
      "description": "输出必须说明区域性薪资数据需要本地来源"
    },
    {
      "type": "field_check",
      "path": "output.suggested_sources",
      "operator": "gte",
      "value": 2,
      "description": "输出必须提供至少2个替代数据来源（如猎聘、BOSS直聘薪资报告、51job行情）"
    }
  ],
  "must_not_contain": [
    {
      "pattern": "confidence.*medium|confidence.*high|置信度.*中|置信度.*高",
      "reason": "无数据时置信度不能为中或高"
    },
    {
      "pattern": "长沙.*工业互联网.*[0-9]+[kK万].*[0-9]+[kK万]",
      "reason": "不能在无数据支撑的情况下给出具体薪资区间"
    },
    {
      "pattern": "根据市场行情.*长沙|市场普遍水平.*长沙",
      "reason": "不能在无来源情况下暗示掌握长沙工业互联网市场数据"
    }
  ]
}
