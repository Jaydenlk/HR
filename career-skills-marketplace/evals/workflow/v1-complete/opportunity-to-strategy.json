{
  "name": "opportunity-intelligence-application-strategist-chain",
  "description": "Tests that opportunity-intelligence feeds structured opportunity data into application-strategist, which produces a prioritized application plan with timeline and rationale.",
  "input": {
    "user_message": "我收集了三个岗位：字节飞书后端P6、美团基础架构P6、拼多多后端P7。帮我分析这些机会并制定投递顺序和策略。",
    "context": {
      "profile_summary": "5年Go/Java后端经验，分布式系统背景，现就职于B轮创业公司",
      "target_roles": [
        { "company": "字节跳动", "role": "飞书后端工程师P6", "jd_snippet": "负责飞书消息系统高并发架构设计，要求5年以上分布式系统经验" },
        { "company": "美团", "role": "基础架构工程师P6", "jd_snippet": "负责内部基础平台建设，要求熟悉K8s和微服务治理" },
        { "company": "拼多多", "role": "后端工程师P7", "jd_snippet": "电商交易链路核心开发，要求高并发高可用设计经验" }
      ]
    }
  },
  "expected_skills_invoked": ["opportunity-intelligence", "application-strategist"],
  "expected_output_properties": {
    "has_opportunity_scores": true,
    "has_application_priority_ranking": true,
    "has_timeline": true,
    "has_rationale_per_opportunity": true,
    "confidence_level": "medium_or_high"
  },
  "assertions": [
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "contains",
      "value": "opportunity-intelligence",
      "description": "机会情报必须被调用以对三家公司进行结构化评分或评估"
    },
    {
      "type": "skills_invoked",
      "path": "skills_invoked",
      "operator": "contains",
      "value": "application-strategist",
      "description": "投递策略师必须被调用，接收机会评估结果并产出优先级排名"
    },
    {
      "type": "field_check",
      "path": "output.opportunity_scores",
      "operator": "exists",
      "value": true,
      "description": "opportunity-intelligence必须为三家公司各产出结构化评分或评估"
    },
    {
      "type": "field_check",
      "path": "output.application_ranking",
      "operator": "exists",
      "value": true,
      "description": "application-strategist必须产出投递优先顺序排名"
    },
    {
      "type": "field_check",
      "path": "output.timeline",
      "operator": "exists",
      "value": true,
      "description": "输出必须包含具体时间建议（如先投哪家及原因）"
    },
    {
      "type": "contains",
      "path": "output.text",
      "operator": "contains",
      "value": "分布式",
      "description": "输出必须至少针对一家公司说明候选人profile与岗位的匹配度"
    },
    {
      "type": "field_check",
      "path": "output.opportunity_scores[*].confidence",
      "operator": "exists",
      "value": true,
      "description": "每个机会评估必须标注置信度"
    }
  ],
  "must_not_contain": [
    {
      "pattern": "薪资.*[0-9]+[kK万].*[0-9]+[kK万]",
      "reason": "不能给出无薪资雷达数据支撑的捏造薪资数字"
    },
    {
      "pattern": "招聘名额.*[0-9]+|headcount quota.*[0-9]+|HC.*[0-9]+个",
      "reason": "不能在无来源情况下声称公司具体招聘名额"
    },
    {
      "pattern": "建议.*投递$|推荐投递$",
      "reason": "每条推荐必须附有明确理由，不能无理由裸推"
    }
  ]
}
