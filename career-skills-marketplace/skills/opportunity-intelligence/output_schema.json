{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opportunity-intelligence 输出",
  "type": "object",
  "required": [
    "skill_name", "skill_version", "summary", "confidence",
    "evidence_used", "recommendations", "risks", "next_actions",
    "follow_up_questions", "cannot_determine",
    "opportunity_score", "match_assessment", "market_positioning",
    "risk_flags", "recommendation"
  ],
  "properties": {
    "skill_name": { "const": "opportunity-intelligence" },
    "skill_version": { "type": "string", "default": "1.0.0" },
    "summary": { "type": "string", "description": "机会综合评估摘要（中文）" },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "insufficient"]
    },
    "evidence_used": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "content"],
        "properties": {
          "source": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "follow_up_questions": { "type": "array", "items": { "type": "string" } },
    "cannot_determine": { "type": "array", "items": { "type": "string" } },
    "opportunity_score": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 100 },
        { "type": "null" }
      ],
      "description": "综合机会评分（0-100），数据不足时为 null"
    },
    "match_assessment": {
      "type": "object",
      "description": "候选人与岗位匹配度评估",
      "required": ["score", "strengths", "gaps"],
      "properties": {
        "score": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 100 },
            { "type": "null" }
          ]
        },
        "strengths": { "type": "array", "items": { "type": "string" } },
        "gaps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "market_positioning": {
      "type": "object",
      "description": "职位市场定位分析",
      "required": ["salary_competitiveness", "company_tier", "growth_potential"],
      "properties": {
        "salary_competitiveness": {
          "type": "string",
          "enum": ["above_market", "at_market", "below_market", "unknown"]
        },
        "company_tier": {
          "type": "string",
          "enum": ["tier1", "tier2", "tier3", "startup", "unknown"]
        },
        "growth_potential": {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown"]
        }
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flag", "severity", "evidence"],
        "properties": {
          "flag": { "type": "string" },
          "severity": { "type": "string", "enum": ["red", "yellow", "notice"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "recommendation": {
      "type": "string",
      "enum": ["strong_apply", "apply_with_caution", "skip", "need_more_info"]
    }
  }
}
