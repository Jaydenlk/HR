{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "company-risk-auditor 输出",
  "type": "object",
  "required": [
    "skill_name", "skill_version", "summary", "confidence",
    "evidence_used", "recommendations", "risks", "next_actions",
    "follow_up_questions", "cannot_determine",
    "risk_profile"
  ],
  "properties": {
    "skill_name": { "const": "company-risk-auditor" },
    "skill_version": { "type": "string", "default": "1.0.0" },
    "summary": {
      "type": "string",
      "description": "公司风险审计概述，必须标注数据来源时效"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "insufficient"],
      "description": "无实时来源时为 low（降级到知识图谱）或 insufficient（无任何数据）"
    },
    "evidence_used": { "type": "array", "items": { "type": "object" } },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "follow_up_questions": { "type": "array", "items": { "type": "string" } },
    "cannot_determine": { "type": "array", "items": { "type": "string" } },
    "risk_profile": {
      "type": "object",
      "required": ["overall_risk", "layoff_history", "culture_signals", "known_issues"],
      "properties": {
        "overall_risk": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical", "unknown"],
          "description": "整体风险等级（无数据时为 unknown）"
        },
        "layoff_history": {
          "type": "object",
          "properties": {
            "has_significant_layoffs": {
              "oneOf": [{ "type": "boolean" }, { "type": "null" }],
              "description": "是否有重大裁员记录（无数据时为 null）"
            },
            "last_layoff_date": {
              "oneOf": [{ "type": "string" }, { "type": "null" }]
            },
            "estimated_scale": {
              "type": "string",
              "description": "裁员规模描述（如 '约 20%'）"
            },
            "sources": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "culture_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["signal", "type", "source"],
            "properties": {
              "signal": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["positive", "negative", "neutral"]
              },
              "source": { "type": "string" }
            }
          }
        },
        "known_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["issue", "severity", "source"],
            "properties": {
              "issue": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low"]
              },
              "source": { "type": "string" },
              "date": { "type": "string" }
            }
          }
        },
        "financial_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "signal": { "type": "string" },
              "type": { "type": "string", "enum": ["positive", "negative", "neutral"] }
            }
          }
        },
        "data_age_warning": {
          "type": "string",
          "description": "数据时效警告（使用历史知识库时必填）"
        }
      }
    }
  }
}
