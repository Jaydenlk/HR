{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "personal-brand-builder/input",
  "title": "personal-brand-builder 输入",
  "type": "object",
  "required": ["profile"],
  "properties": {
    "profile": {
      "type": "object",
      "description": "来自 profile-builder 的用户画像",
      "additionalProperties": true
    },
    "brand_focus": {
      "type": "string",
      "enum": ["technical_depth", "industry_insight", "career_experience", "auto"],
      "default": "auto"
    },
    "target_audience": {
      "type": "string",
      "description": "目标受众"
    }
  },
  "additionalProperties": false
}
