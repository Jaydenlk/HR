{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "learning-roadmap-builder/input",
  "title": "learning-roadmap-builder 输入",
  "type": "object",
  "required": ["skill_gaps"],
  "properties": {
    "skill_gaps": {
      "type": "array",
      "minItems": 1,
      "description": "技能差距列表，来自 skill-gap-planner 的 gap_analysis",
      "items": {
        "type": "object",
        "required": ["skill_name"],
        "properties": {
          "skill_name": { "type": "string" },
          "gap_severity": {
            "type": "string",
            "enum": ["critical", "important", "nice_to_have"]
          },
          "user_current": { "type": "string" },
          "target_required": { "type": "string" }
        }
      }
    },
    "profile": {
      "type": "object",
      "description": "用户画像，用于定制化",
      "additionalProperties": true
    },
    "weekly_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 80,
      "default": 12
    },
    "preferred_language": {
      "type": "string",
      "enum": ["zh", "en", "both"],
      "default": "zh"
    }
  },
  "additionalProperties": false
}
