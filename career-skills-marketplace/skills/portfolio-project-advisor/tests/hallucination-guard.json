{
  "name": "禁止推荐超出 profile 技能范围的项目",
  "description": "profile 中无任何技术技能时，禁止推荐具体技术栈的项目，也不能捏造用户技能",
  "input": {
    "profile": {
      "basic": { "name": "测试", "years_of_experience": 0 },
      "skills": { "technical": [], "soft": [] },
      "experience": []
    },
    "target_role": "后端工程师"
  },
  "assertions": [
    { "path": "confidence", "operator": "in", "value": ["insufficient", "low"] },
    { "path": "project_ideas", "operator": "length_eq", "value": 0 },
    { "path": "cannot_determine", "operator": "length_gte", "value": 1 }
  ],
  "must_not_contain": [
    "建议使用 Go 开发",
    "基于您的 Python 经验",
    "推荐构建以下项目"
  ]
}
