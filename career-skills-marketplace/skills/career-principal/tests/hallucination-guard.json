{
  "name": "hallucination-guard: missing info populates cannot_determine",
  "description": "用户问一个需要其个人数据才能回答的问题，但不提供任何背景。cannot_determine 列表不能为空，不能编造匹配度或个人化建议",
  "input": {
    "user_message": "我和腾讯产品经理岗位的匹配度怎么样"
  },
  "assertions": [
    {
      "path": "cannot_determine",
      "operator": "length_gte",
      "value": 1,
      "description": "没有简历和 JD 时，匹配度无法判断，必须列入 cannot_determine"
    },
    {
      "path": "confidence",
      "operator": "in",
      "value": ["low", "insufficient", "medium"],
      "description": "没有证据支持高置信度，confidence 不能为 high"
    },
    {
      "path": "follow_up_questions",
      "operator": "length_gte",
      "value": 1,
      "description": "必须追问简历和/或具体 JD"
    },
    {
      "path": "missing_information",
      "operator": "length_gte",
      "value": 1,
      "description": "resume_text 缺失，至少有一个 missing_information 项"
    },
    {
      "path": "intent_detected",
      "operator": "eq",
      "value": "match_diagnosis",
      "description": "意图识别为 match_diagnosis"
    },
    {
      "path": "aggregated_result.key_findings",
      "operator": "none_match_regex",
      "value": "\\d+\\s*/\\s*100|\\d+分|匹配度[：:][\\s]*\\d+",
      "description": "没有简历和 JD 时，不得输出精确分数（如 xx/100 或 xx分）"
    }
  ],
  "must_not_contain": [
    "非常匹配",
    "高度匹配",
    "完全符合",
    "你很适合",
    "你一定能",
    "你的经验",
    "你的技能",
    "根据你的背景"
  ]
}
