{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "technical-interview-coach/input",
  "title": "technical-interview-coach 输入",
  "type": "object",
  "required": ["job_title"],
  "properties": {
    "job_title": {
      "type": "string",
      "minLength": 1,
      "description": "目标技术岗位名称"
    },
    "company_name": {
      "type": "string",
      "description": "目标公司名称"
    },
    "user_profile": {
      "type": "object",
      "description": "用户画像（来自 profile-builder）",
      "additionalProperties": true
    },
    "interview_intelligence": {
      "type": "object",
      "description": "面试情报（来自 interview-intelligence）",
      "additionalProperties": true
    },
    "available_weeks": {
      "type": "integer",
      "minimum": 1,
      "description": "可用备考时间（周）"
    }
  },
  "additionalProperties": false
}
