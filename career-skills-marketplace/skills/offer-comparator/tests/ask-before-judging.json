{
  "name": "ask-before-judging-single-incomplete-offer",
  "description": "仅有一个 offer 且关键字段缺失（无城市、无工时、无福利），无法做有效比较或评分",
  "input": {
    "offers": [
      {
        "company": "某互联网公司",
        "base_monthly": 25000
      }
    ]
  },
  "product_principle": "ask-before-judging",
  "assertions": [
    {
      "type": "field_check",
      "path": "confidence",
      "operator": "in",
      "value": ["low", "insufficient"],
      "description": "置信度不能高于 low"
    },
    {
      "type": "field_check",
      "path": "cannot_determine",
      "operator": "length_gte",
      "value": 1,
      "description": "必须列出缺失字段：城市、工时、福利、股票等"
    },
    {
      "type": "field_check",
      "path": "follow_up_questions",
      "operator": "length_gte",
      "value": 1,
      "description": "必须询问城市生活成本、实际工时、福利明细"
    },
    {
      "type": "field_check",
      "path": "next_actions",
      "operator": "length_gte",
      "value": 1,
      "description": "必须给出可执行下一步，如补充完整 offer 字段或提供对比 offer"
    }
  ],
  "must_not_contain": [
    {
      "pattern": "强烈推荐|非常匹配|完美契合",
      "reason": "信息不足时不能给强结论"
    },
    {
      "pattern": "\\b(9[0-9]|100)\\s*分",
      "reason": "信息不足时不能给高分"
    }
  ]
}
