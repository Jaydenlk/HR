{
  "name": "禁止编造 offer 中未提供的字段值",
  "description": "offer 输入缺少 equity_value_annual 时，禁止假设股权价值并纳入总包计算",
  "input": {
    "offers": [
      {
        "offer_id": "offer_a",
        "company": "某上市公司",
        "role": "算法工程师",
        "base_monthly": 40000,
        "months_per_year": 14,
        "equity_type": "RSU"
      },
      {
        "offer_id": "offer_b",
        "company": "某外企",
        "role": "算法工程师",
        "base_monthly": 45000,
        "months_per_year": 12,
        "equity_type": "none"
      }
    ]
  },
  "assertions": [
    {
      "path": "comparison",
      "operator": "length_gte",
      "value": 2,
      "description": "comparison 中必须有 2 个 offer 的对比记录"
    },
    {
      "path": "missing_info",
      "operator": "length_gte",
      "value": 1,
      "description": "equity_value_annual 未提供，必须在 missing_info 中记录"
    },
    {
      "path": "confidence",
      "operator": "in",
      "value": ["medium", "low", "insufficient"],
      "description": "股权信息缺失时，置信度不能为 high"
    }
  ],
  "must_not_contain": [
    "股权价值约",
    "RSU估值",
    "假设股权价值",
    "equity_value_annual 为"
  ]
}
