{
  "name": "ask-before-judging-single-source-no-live-data",
  "description": "查询范围为 AI 岗位，但无实时数据，仅有单一小红书来源，结论可信度不足",
  "input": {
    "scope": "AI岗位",
    "simulate_no_live_data": true,
    "sources": [
      {
        "platform": "XHS",
        "content": "AI算法岗现在很热门，大厂都在疯狂扩招",
        "date": null,
        "url": null
      }
    ]
  },
  "product_principle": "ask-before-judging",
  "assertions": [
    {
      "type": "field_check",
      "path": "confidence",
      "operator": "in",
      "value": ["low", "insufficient"],
      "description": "置信度不能高于 low"
    },
    {
      "type": "field_check",
      "path": "cannot_determine",
      "operator": "length_gte",
      "value": 1,
      "description": "必须说明数据来源不足、缺乏时效性或无实时数据支撑"
    },
    {
      "type": "field_check",
      "path": "follow_up_questions",
      "operator": "length_gte",
      "value": 1,
      "description": "必须询问具体岗位方向、城市或行业细分以缩小范围"
    },
    {
      "type": "field_check",
      "path": "next_actions",
      "operator": "length_gte",
      "value": 1,
      "description": "必须给出可执行下一步，如补充数据来源后重试"
    }
  ],
  "must_not_contain": [
    {
      "pattern": "强烈推荐|非常匹配|完美契合",
      "reason": "信息不足时不能给强结论"
    },
    {
      "pattern": "\\b(9[0-9]|100)\\s*分",
      "reason": "信息不足时不能给高分"
    }
  ]
}
