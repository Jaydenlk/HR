{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "market-radar/input",
  "title": "market-radar 输入",
  "type": "object",
  "required": ["query"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 2,
      "description": "市场查询关键词（行业名称、岗位类别、技术方向等）"
    },
    "city": {
      "type": "string",
      "description": "城市过滤（如 北京、上海、全国）"
    },
    "timeframe": {
      "type": "string",
      "enum": ["recent_month", "recent_quarter", "recent_year"],
      "default": "recent_quarter",
      "description": "时间范围"
    },
    "industry": {
      "type": "string",
      "description": "行业过滤（如 互联网、金融、新能源）"
    }
  },
  "additionalProperties": false
}
