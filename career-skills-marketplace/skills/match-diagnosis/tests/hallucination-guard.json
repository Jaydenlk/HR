{
  "name": "幻觉防护 — 画像中无 Python 技能，不能在技能匹配中给 Python 正分",
  "description": "验证技能的幻觉防护：当用户画像中没有 Python 技能，而 JD 要求 Python 时，不能在技能维度分析中给 Python 匹配打正分",
  "input": {
    "user_profile": {
      "basic_info": {
        "name": "刘明",
        "years_of_experience": 3,
        "location": "北京"
      },
      "work_experience": [
        {
          "company": "某银行",
          "title": "Java 开发工程师",
          "description": "使用 Java 开发银行系统"
        }
      ],
      "skills": {
        "technical": ["Java", "Spring Boot", "MySQL", "Oracle"]
      }
    },
    "jd_analysis": {
      "job_title": "后端工程师",
      "required_skills": [
        { "skill": "Python", "level": "required" },
        { "skill": "Java", "level": "preferred" }
      ],
      "keywords": ["Python", "Django", "Flask", "数据分析"]
    }
  },
  "assertions": [
    {
      "path": "match_result",
      "operator": "exists",
      "value": true,
      "description": "必须存在 match_result 对象"
    },
    {
      "path": "match_result.match_label",
      "operator": "in",
      "value": ["weak_match", "no_match", "moderate_match"],
      "description": "Python 是 required 必须项，用户不具备，匹配标签不能是 perfect_fit 或 strong_match"
    },
    {
      "path": "match_result.weaknesses",
      "operator": "length_gte",
      "value": 1,
      "description": "weaknesses 数组至少有一条，应提及 Python 缺失"
    },
    {
      "path": "match_result.gap_classification",
      "operator": "length_gte",
      "value": 1,
      "description": "gap_classification 中必须存在关于 Python 的差距记录"
    },
    {
      "path": "match_result.dimension_scores",
      "operator": "length_eq",
      "value": 5,
      "description": "dimension_scores 必须有 5 个维度"
    }
  ],
  "must_not_contain": [
    "Python 已匹配",
    "Python 满足要求",
    "Python 符合",
    "熟悉 Python",
    "具备 Python"
  ]
}
