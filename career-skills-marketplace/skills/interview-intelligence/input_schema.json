{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "interview-intelligence/input",
  "title": "interview-intelligence 输入",
  "type": "object",
  "required": ["company_name", "job_title"],
  "properties": {
    "company_name": {
      "type": "string",
      "minLength": 1,
      "description": "目标公司名称"
    },
    "job_title": {
      "type": "string",
      "minLength": 1,
      "description": "目标岗位名称"
    },
    "user_profile": {
      "type": "object",
      "description": "用户画像（来自 profile-builder），用于个性化备考建议",
      "additionalProperties": true
    },
    "jd_analysis": {
      "type": "object",
      "description": "JD 解析结果（来自 jd-analyzer），补充岗位技术栈信息",
      "additionalProperties": true
    },
    "interview_date": {
      "type": "string",
      "description": "面试日期（ISO 8601 格式），用于评估时间紧迫度"
    },
    "source_audit": {
      "type": "object",
      "description": "来源审计结果（来自 source-quality-auditor），用于动态调整数据置信度上限"
    }
  },
  "additionalProperties": false
}
