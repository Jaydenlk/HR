{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillOutputBase",
  "description": "所有 skill 输出的通用基础字段",
  "type": "object",
  "required": [
    "skill_name",
    "skill_version",
    "summary",
    "confidence",
    "evidence_used",
    "recommendations",
    "risks",
    "next_actions",
    "cannot_determine"
  ],
  "properties": {
    "skill_name": {
      "type": "string",
      "description": "Skill 名称，如 'opportunity-evaluator'"
    },
    "skill_version": {
      "type": "string",
      "default": "1.0.0",
      "description": "Skill 版本号（语义化版本）"
    },
    "summary": {
      "type": "string",
      "description": "一句话结论，供用户快速获取核心判断"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "insufficient"],
      "description": "整体置信度，取所有维度中最低（木桶原则）"
    },
    "evidence_used": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_type",
          "source_name",
          "source_url",
          "content_excerpt",
          "freshness",
          "reason"
        ],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "user_resume",
              "user_input",
              "jd_text",
              "jd_url",
              "knowledge_graph",
              "market_prior",
              "web_search",
              "xhs",
              "nowcoder",
              "wechat",
              "ai_inference",
              "peer_review"
            ],
            "description": "证据来源类型，与 evidence-schema/evidence.schema.json 的 source_type enum 对齐"
          },
          "source_name": {
            "type": "string",
            "description": "如 '用户简历.pdf'、'Boss直聘'"
          },
          "source_url": {
            "type": ["string", "null"],
            "description": "可追溯链接，无则 null"
          },
          "content_excerpt": {
            "type": "string",
            "maxLength": 500,
            "description": "原文摘录，最多 500 字符"
          },
          "freshness": {
            "type": "string",
            "enum": ["current", "recent", "stale"],
            "description": "current: <7天, recent: 7-30天, stale: >30天"
          },
          "reason": {
            "type": "string",
            "description": "为什么采用这条证据"
          }
        },
        "additionalProperties": true
      },
      "description": "使用的证据列表，每项至少含 evidence.schema.json 核心子集 (source_type/source_name/source_url/content_excerpt/freshness/reason)；可携带 SkillEvidence 完整字段"
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "具体可行的改进建议"
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "已识别风险点"
    },
    "next_actions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "推荐的后续行动步骤"
    },
    "suggested_next": {
      "type": "array",
      "description": "本意图完成后顺势提议的下一意图（分步、条件触发）；提议+用户确认才执行，默认不自动连跳",
      "items": {
        "type": "object",
        "required": ["next_intent", "reason", "ready_inputs", "priority"],
        "properties": {
          "next_intent": {
            "type": "string",
            "description": "建议续接的下一意图名（与 router 意图集对齐）"
          },
          "reason": {
            "type": "string",
            "description": "为何此时提议该意图"
          },
          "ready_inputs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "已就绪、可直接复用的入参键（如 resume_text/jd_text/上一意图产出），续接时跳过重复追问"
          },
          "priority": {
            "type": "string",
            "enum": ["recommended", "optional"],
            "description": "recommended=强相关建议优先;optional=可选续接"
          }
        },
        "additionalProperties": false
      }
    },
    "follow_up_questions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "需要用户补充的追问"
    },
    "cannot_determine": {
      "type": "array",
      "items": { "type": "string" },
      "description": "因信息不足无法判断的事项，不可为空（有则列出，无则 []）"
    }
  },
  "additionalProperties": true,
  "$comment": "各 skill 可在此基础上扩展专属字段，但必须包含所有 required 字段"
}
