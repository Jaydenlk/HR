{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "industry-trend-analyst 输出",
  "type": "object",
  "required": [
    "skill_name", "skill_version", "summary", "confidence",
    "evidence_used", "recommendations", "risks", "next_actions",
    "follow_up_questions", "cannot_determine",
    "trend_summary", "growth_signals", "risk_signals",
    "hiring_outlook", "recommended_entry_roles"
  ],
  "properties": {
    "skill_name": { "const": "industry-trend-analyst" },
    "skill_version": { "type": "string", "default": "1.0.0" },
    "summary": {
      "type": "string",
      "description": "行业趋势分析概述（无数据时说明降级原因）"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "insufficient"],
      "description": "无实时数据时必须为 insufficient"
    },
    "evidence_used": {
      "type": "array",
      "items": { "type": "object" },
      "description": "使用的实时数据来源（无实时数据时为空）"
    },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "follow_up_questions": { "type": "array", "items": { "type": "string" } },
    "cannot_determine": { "type": "array", "items": { "type": "string" } },
    "trend_summary": {
      "type": "string",
      "description": "行业趋势概要（无数据时为降级说明）"
    },
    "growth_signals": {
      "type": "array",
      "description": "增长信号（无实时数据时为空数组）",
      "items": {
        "type": "object",
        "required": ["signal", "source", "date"],
        "properties": {
          "signal": { "type": "string" },
          "strength": {
            "type": "string",
            "enum": ["strong", "moderate", "weak"],
            "description": "信号强度"
          },
          "source": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    },
    "risk_signals": {
      "type": "array",
      "description": "风险信号（无实时数据时为空数组）",
      "items": {
        "type": "object",
        "required": ["signal", "source", "date"],
        "properties": {
          "signal": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "source": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    },
    "hiring_outlook": {
      "type": "string",
      "enum": ["strong", "growing", "stable", "declining", "contracting", "unknown"],
      "description": "招聘前景（无数据时为 unknown）"
    },
    "recommended_entry_roles": {
      "type": "array",
      "description": "推荐的入行岗位（无实时数据时为空数组）",
      "items": {
        "type": "object",
        "required": ["role_name", "rationale"],
        "properties": {
          "role_name": { "type": "string" },
          "rationale": { "type": "string", "description": "推荐理由" },
          "demand_level": {
            "type": "string",
            "enum": ["high", "medium", "low", "unknown"]
          }
        }
      }
    },
    "market_radar_used": {
      "type": "boolean",
      "description": "是否调用了 market-radar skill"
    }
  }
}
