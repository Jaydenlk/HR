{
  "description": "profile.constraints.location 之外的城市应在 fit_matrix 中得到低 constraint_satisfaction 分",
  "input": {
    "profile": {
      "basic": { "name": "测试", "years_of_experience": 3 },
      "skills": { "technical": [{ "name": "Python", "proficiency": "used_in_project", "evidence_source": "项目" }] },
      "experience": [{ "company": "某公司", "role": "工程师", "duration": "2023-至今" }],
      "constraints": { "location": ["杭州"] }
    },
    "candidate_cities": ["杭州", "成都"]
  },
  "assertions": [
    { "path": "fit_matrix", "operator": "length_gte", "value": 2 },
    { "path": "fit_matrix", "operator": "has_item_with_lower_score", "city": "成都", "dimension": "constraint_satisfaction", "than_city": "杭州" }
  ]
}
